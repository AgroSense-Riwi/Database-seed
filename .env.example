# Database credentials. Replace the password with a long random hexadecimal value.
POSTGRES_USER=agrosense
POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD
POSTGRES_DB=agrosense_db

# Private interface address assigned to this DB server; do not use the API server IP.
POSTGRES_BIND_ADDRESS=10.0.1.20
POSTGRES_PORT=5432

# Seed options
SEED_PROFILE=dev
SEED_RANDOM_STATE=42
SEED_DEFECT_GLOBAL_RATE=0.05
SEED_DB_BATCH_SIZE=1000
SEED_RESET_BEFORE_RUN=false
